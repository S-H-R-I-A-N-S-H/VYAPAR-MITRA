# ==============================================================================
# VYAPAR MITRA - Global Environment Configuration Template
# Copy this file to `.env` and populate with actual credentials.
# NEVER commit `.env` containing sensitive credentials to version control.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000
HOST=0.0.0.0

# Supabase (Managed PostgreSQL, Auth, and Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Model Provider (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.1-flash-lite,gemini-3.6-flash

# Bhashini (Speech & Indian Language Layer - ULCA https://bhashini.gov.in/ulca)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_INFERENCE_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d0

# Mappls / MapmyIndia (Geospatial & Mapping Layer - https://developer.mappls.com)
# If left empty or dummy, backend uses the local mock/sandbox fallback
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
