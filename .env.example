# ==============================================================================
# VYAPAR MITRA - Global Environment Configuration Template
# Copy this file to `.env` and populate with actual credentials.
# NEVER commit `.env` containing sensitive credentials to version control.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000
HOST=0.0.0.0

# Supabase (Managed PostgreSQL, Auth, and Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Model Provider (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Bhashini (Speech & Indian Language Layer)
# If left empty or dummy, backend uses the local mock/sandbox fallback
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Mappls / MapmyIndia (Geospatial & Mapping Layer)
# If left empty or dummy, backend uses the local mock/sandbox fallback
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
